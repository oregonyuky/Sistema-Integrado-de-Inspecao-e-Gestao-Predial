# Banco de dados PostgreSQL
DATABASE_URL="postgresql://siigp:siigp@localhost:5432/siigp"
# Banco usado pelos testes automatizados (é APAGADO e recriado a cada execução)
TEST_DATABASE_URL="postgresql://siigp:siigp@localhost:5432/siigp_test"

# Segredo da sessão (mínimo 32 caracteres). Gere com: openssl rand -base64 48
SESSION_SECRET="troque-este-valor-por-um-segredo-longo-e-aleatorio-0123456789"

# Diretório de anexos (fora de /public; acessado apenas via API autenticada)
STORAGE_DIR="./storage"

# Usuário administrador criado por `npm run db:seed`
SEED_ORG_NAME="Minha Organização"
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="troque-esta-senha-12"
