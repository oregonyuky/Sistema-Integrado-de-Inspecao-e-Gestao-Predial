{
  "name": "siigp",
  "version": "0.1.0",
  "private": true,
  "description": "SIIGP – Sistema Integrado de Inspeção e Gestão Predial · Módulo RF01",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:apply": "tsx scripts/db-apply.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts --demo",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@prisma/adapter-pg": "6.19",
    "@prisma/client": "6.19",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.18",
    "next": "^15.5.9",
    "pg": "^8.23.1",
    "prisma": "6.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
